@model WebPccuClub.Models.BorrowMailTemplateMangViewModel

@{
    Layout = "_BackendLayout";
}

<head>
    <script src="~/js/backend_case.js"></script>
</head>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <!-- /.row -->
        <div class="row">
            <div class="col-12">
                <form method="post" id="form" enctype="multipart/form-data" action="">

                    <div class="card">
                        <div class="card-body table-responsive-sm">
                            <h6 class="card-subtitle mb-2 text-muted">
                                <a id="Back" href="@Url.Action("Index")" class="btn btn-outline-primary">返回</a>
                                <span class="required font-weight-bold">*</span> <small>為必填欄位</small>
                            </h6>
                            <table class="table table-bordered">
                                <tbody>
                                    <tr>
                                        <th width="10%">範本名稱<span class="required">*</span></th>
                                        <td>@Html.TextBoxFor(m => m.CreateModel.TemplateName, new { @class = "form-control", placeholder = "請輸入範本名稱" })</td>
                                    </tr>
                                    <tr>
                                        <th width="10%">借用類別<span class="required">*</span></th>
                                        <td>
                                            @Html.DropDownListFor(m => m.CreateModel.BorrowMainClassID, (List<SelectListItem>)ViewBag.ddlMainClass, "請選擇借用類別", new { @class = "form-control" })
                                        </td>
                                    </tr>
                                    
                                    <tr>
                                        <th width="10%">是否啟用<span class="required">*</span></th>
                                        <td>
                                            @Html.DropDownListFor(m => m.CreateModel.IsEnable, (List<SelectListItem>)ViewBag.ddlEnable, "是否啟用", new { @class = "form-control" })
                                        </td>
                                    </tr>
                                    <tr>
                                        <th width="10%">信件主旨<span class="required">*</span></th>
                                        <td>@Html.TextAreaFor(m => m.CreateModel.SubjectTemplate, new { @class = "form-control", placeholder = "請輸入信件主旨"})</td>
                                    </tr>

                                    <tr>
                                        <th width="10%">信件內容<span class="required">*</span></th>
                                        <td>@Html.TextAreaFor(m => m.CreateModel.BodyTemplate, new { @class = "form-control", placeholder = "請輸入信件內容", rows = "5" })</td>
                                    </tr>
                                </tbody>
                            </table>

                        </div>

                        <div class="card-footer d-flex justify-content-end">
                            <button type="button" class="mx-1 btn btn-outline-dark" onclick="Reset()">重設</button>
                            <button type="button" class="btn btn-success" onclick="SaveData()">儲存</button>
                        </div>
                    </div>
                    <!-- /.card -->
                </form> 
                <!-- /.form -->
            </div>
        </div>
        <!-- /.row -->


    </div><!-- /.container-fluid -->
</section>
<!-- /.content -->

<script>

    function SaveData() {

        var data = new FormData()

        var TemplateName = $('#@Html.IdFor(m => m.CreateModel.TemplateName)').val();
        var BorrowMainClassID = $('#@Html.IdFor(m => m.CreateModel.BorrowMainClassID)').val();
        var IsEnable = $('#@Html.IdFor(m => m.CreateModel.IsEnable)').val();
        var SubjectTemplate = $('#@Html.IdFor(m => m.CreateModel.SubjectTemplate)').val();
        var BodyTemplate = $('#@Html.IdFor(m => m.CreateModel.BodyTemplate)').val();

        if (TemplateName == "") { $.alert("範本名稱不可為空白"); return; }
        if (BorrowMainClassID == "") { $.alert("借用類別需選擇"); return; }
        if (IsEnable == "") { $.alert("是否啟用需選擇"); return; }
        if (SubjectTemplate == "") { $.alert("信件主旨不可為空白"); return; }
        if (BodyTemplate == "") { $.alert("信件內容不可為空白"); return; }

        data.append('@Html.NameFor(m => m.CreateModel.TemplateName)', TemplateName);
        data.append('@Html.NameFor(m => m.CreateModel.BorrowMainClassID)', BorrowMainClassID);
        data.append('@Html.NameFor(m => m.CreateModel.IsEnable)', IsEnable);
        data.append('@Html.NameFor(m => m.CreateModel.SubjectTemplate)', SubjectTemplate);
        data.append('@Html.NameFor(m => m.CreateModel.BodyTemplate)', BodyTemplate);

        SendAjax({
            url: '@Url.Action("SaveNewData")',
            data: data,
            processData: false,
            contentType: false,
            success: function (result) {
                if (result.errorCode == 0) {
                    $.confirm({
                        title: "",
                        content: "新增成功",
                        buttons: {
                            確定: function () {
                                window.location = $("#Back").attr("href");
                            },
                        }
                    });
                }
                else { $.alert(result.errorMsg); }
            },
        });
    }

    function Reset() {
        $('#@Html.IdFor(m => m.CreateModel.TemplateName)').val("");
        $('#@Html.IdFor(m => m.CreateModel.BorrowMainClassID)').val("");
        $('#@Html.IdFor(m => m.CreateModel.IsEnable)').val("");
        $('#@Html.IdFor(m => m.CreateModel.SubjectTemplate)').val("");
        $('#@Html.IdFor(m => m.CreateModel.BodyTemplate)').val("");
    }
</script>