@model WebPccuClub.Models.ClubEvaluationMangViewModel

@{
    Layout = "_BackendLayout";
}

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <!-- /.row -->
        <div class="row">
            <div class="col-12">
                <form method="post" id="form" enctype="multipart/form-data" action="">

                    <div class="card">
                        <div class="card-body table-responsive-sm">
                            <h6 class="card-subtitle mb-2 text-muted">
                                <a id="Back" href="@Url.Action("Index")" class="btn btn-outline-primary">返回</a>
                                <span class="required font-weight-bold">*</span> <small>為必填欄位</small>
                            </h6>
                            <table class="table table-bordered">
                                <tbody>
                                    <tr>
                                        <th width="15%">@Html.LabelFor(m => m.CreateModel.SchoolYear)<span class="required">*</span></th>
                                        <td>
                                            @Html.EditorFor(m => m.CreateModel.SchoolYear, new
                                                {
                                                    htmlAttributes = new
                                                    {
                                                        @class = "form-control",
                                                        type = "number",
                                                        placeholder = "請輸入學年度",
                                                        onkeydown = "return ['e', 'E', '+', '-'].includes(event.key) ? false : true;"
                                                    }
                                                })
                                        </td>
                                    </tr>
                                    <tr>
                                        <th width="15%">@Html.LabelFor(m => m.CreateModel.ClubID)<span class="required">*</span></th>
                                        <td>
                                            @Html.DropDownListFor(m => m.CreateModel.ClubID, (List<SelectListItem>)ViewBag.ddlClub, "請選擇社團", new { @class = "form-control" })
                                        </td>
                                    </tr>
                                    <tr>
                                        <th width="15%">@Html.LabelFor(m => m.CreateModel.ClubEvaluationClassId)<span class="required">*</span></th>
                                        <td>
                                            @Html.DropDownListFor(m => m.CreateModel.ClubEvaluationClassId, (List<SelectListItem>)ViewBag.ddlClassId, "請選擇類別", new { @class = "form-control" })
                                        </td>
                                    </tr>
                                    <tr>
                                        <th width="15%">@Html.LabelFor(m => m.CreateModel.ClubEvaluationItemId)<span class="required">*</span></th>
                                        <td>
                                            @Html.DropDownListFor(m => m.CreateModel.ClubEvaluationItemId, new List<SelectListItem>(), "請先選擇類別", new { @class = "form-control", @disabled = "disabled" })
                                        </td>
                                    </tr>
                                    <tr>
                                        <th width="15%">@Html.LabelFor(m => m.CreateModel.Score)<span class="required">*</span></th>
                                        <td>@Html.TextBoxFor(m => m.CreateModel.Score, new { @class = "form-control", type = "number", placeholder = "請輸入分數" })</td>
                                    </tr>
                                    <tr>
                                        <th width="15%">@Html.LabelFor(m => m.CreateModel.Memo)</th>
                                        <td>@Html.TextAreaFor(m => m.CreateModel.Memo, new {@class = "form-control", placeholder = "請輸入備註", rows = "6"})</td>
                                    </tr>
                                </tbody>
                            </table>

                        </div>

                        <div class="card-footer d-flex justify-content-end">
                            <button type="button" class="mx-1 btn btn-outline-dark" onclick="Reset()">重設</button>
                            <button type="button" class="btn btn-success" onclick="SaveData()">儲存</button>
                        </div>
                    </div>
                    <!-- /.card -->
                </form> 
                <!-- /.form -->
            </div>
        </div>
        <!-- /.row -->


    </div><!-- /.container-fluid -->
</section>
<!-- /.content -->

<script>

    $(document).ready(function () {
        // 監聽「類別」下拉選單的變更事件
        $('#@Html.IdFor(m => m.CreateModel.ClubEvaluationClassId)').change(function () {
            var classId = $(this).val();
            var itemSelect = $('#@Html.IdFor(m => m.CreateModel.ClubEvaluationItemId)');

            // 清空目前的選項
            itemSelect.empty();

            if (classId === "") {
                itemSelect.append($('<option>', { value: '', text: '請先選擇類別' }));
                itemSelect.prop('disabled', true);
                return;
            }

            // 發送 Ajax 取得該類別下的所有項目
            SendAjax({
                url: '@Url.Action("GetItemsByClassId")', // 請確認後端有此 Action
                data: { classId: classId },
                success: function (result) {
                    if (result && result.length > 0) {
                        itemSelect.append($('<option>', { value: '', text: '請選擇項目' }));
                        $.each(result, function (index, item) {
                            itemSelect.append($('<option>', {
                                value: item.value,
                                text: item.text
                            }));
                        });
                        itemSelect.prop('disabled', false); // 啟用下拉選單
                    } else {
                        itemSelect.append($('<option>', { value: '', text: '此類別下無項目' }));
                        itemSelect.prop('disabled', true);
                    }
                },
                error: function () {
                    $.alert("取得項目資料失敗");
                }
            });
        });
    });

    function SaveData() {

        var data = new FormData()
        var SchoolYear = $('#@Html.IdFor(m => m.CreateModel.SchoolYear)').val();
        var ClubID = $('#@Html.IdFor(m => m.CreateModel.ClubID)').val();
        var ClubEvaluationClassId = $('#@Html.IdFor(m => m.CreateModel.ClubEvaluationClassId)').val();
        var ClubEvaluationItemId = $('#@Html.IdFor(m => m.CreateModel.ClubEvaluationItemId)').val();
        var Score = $('#@Html.IdFor(m => m.CreateModel.Score)').val();
        var Memo = $('#@Html.IdFor(m => m.CreateModel.Memo)').val();

        if (SchoolYear == "") { $.alert("請選擇學年度"); return; }
        if (ClubID == "") { $.alert("請選擇社團"); return; }
        if (ClubEvaluationClassId == "") { $.alert("請選擇類別"); return; }
        if (ClubEvaluationItemId == "") { $.alert("請選擇項目"); return; }
        if (Score == "") { $.alert("請輸入分數"); return; }

        data.append('@Html.NameFor(m => m.CreateModel.SchoolYear)', SchoolYear);
        data.append('@Html.NameFor(m => m.CreateModel.ClubID)', ClubID);
        data.append('@Html.NameFor(m => m.CreateModel.ClubEvaluationClassId)', ClubEvaluationClassId);
        data.append('@Html.NameFor(m => m.CreateModel.ClubEvaluationItemId)', ClubEvaluationItemId);
        data.append('@Html.NameFor(m => m.CreateModel.Score)', Score);
        data.append('@Html.NameFor(m => m.CreateModel.Memo)', Memo);

        SendAjax({
            url: '@Url.Action("SaveNewData")',
            data: data,
            processData: false,
            contentType: false,
            success: function (result) {
                if (result.errorCode == 0) {
                    $.confirm({
                        title: "",
                        content: "新增成功",
                        buttons: {
                            確定: function () {
                                Reset();
                            },
                        }
                    });
                }
                else { $.alert(result.errorMsg); }
            },
        });
    }

    function Reset() {
        $('#@Html.IdFor(m => m.CreateModel.SchoolYear)').val("");
        $('#@Html.IdFor(m => m.CreateModel.ClubID)').val("");
        $('#@Html.IdFor(m => m.CreateModel.ClubEvaluationClassId)').val("");
        $('#@Html.IdFor(m => m.CreateModel.ClubEvaluationItemId)').val("");
        $('#@Html.IdFor(m => m.CreateModel.Score)').val("");
        $('#@Html.IdFor(m => m.CreateModel.Memo)').val("");
    }
</script>